# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Sentry (error monitoring) ─────────────────────────────────────────────────
# Create a project at https://sentry.io → Settings → Projects → DSN
NEXT_PUBLIC_SENTRY_DSN=https://xxx@oxx.ingest.sentry.io/yyy
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
# SENTRY_AUTH_TOKEN is needed only for source map uploads (CI/Vercel build)
SENTRY_AUTH_TOKEN=

# ── Push notifications (VAPID) ────────────────────────────────────────────────
# Stored in Supabase app_config table (vapid_public_key / vapid_private_key / vapid_subject)
# Also expose the public key to the client for ServiceWorker subscription
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Add as a Supabase Edge Function secret: supabase secrets set RESEND_API_KEY=re_xxx
# Get a key at https://resend.com → API Keys
# RESEND_API_KEY=re_xxx  ← set in Supabase dashboard, NOT here

# ── OpenAgenda (optional second data source) ──────────────────────────────────
# Add as a Supabase Edge Function secret: supabase secrets set OPENAGENDA_API_KEY=xxx
# Get a key at https://openagenda.com → Mon compte → Clés API
# OPENAGENDA_API_KEY=xxx  ← set in Supabase dashboard, NOT here

# ── AI Moderation (Anthropic) ─────────────────────────────────────────────────
# Add as a Supabase Edge Function secret: supabase secrets set ANTHROPIC_API_KEY=sk-ant-xxx
# Get a key at https://console.anthropic.com → API Keys
# ANTHROPIC_API_KEY=sk-ant-xxx  ← set in Supabase dashboard, NOT here

# ── Site URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-domain.com
